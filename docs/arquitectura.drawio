  <diagram id="pagina-hexagonal" name="1 · Patron hexagonal">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p1_0" />
        <mxCell id="p1_1" parent="p1_0" />

        <!-- ======================= TITULOS ======================= -->
        <mxCell id="p1_title" value="Invoice Processing System — Patron hexagonal (puertos y adaptadores)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" vertex="1" parent="p1_1">
          <mxGeometry x="40" y="16" width="1420" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1_rule" value="REGLA DE ORO: todas las flechas de dependencia apuntan HACIA el dominio — el dominio no importa frameworks, ni BD, ni HTTP, ni Celery." style="text;html=1;strokeColor=#b85450;fillColor=#fce8e6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#ae4132;" vertex="1" parent="p1_1">
          <mxGeometry x="40" y="54" width="1420" height="26" as="geometry" />
        </mxCell>

        <!-- ======================= PRESENTACION ======================= -->
        <mxCell id="p1_pres" value="PRESENTACION  (drivers)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;spacingTop=6;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=6;" vertex="1" parent="p1_1">
          <mxGeometry x="40" y="100" width="270" height="620" as="geometry" />
        </mxCell>
        <mxCell id="p1_fastapi" value="&lt;b&gt;FastAPI :8000&lt;/b&gt;&lt;br&gt;routers · deps · schemas&lt;br&gt;mappers · exception_handlers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p1_pres">
