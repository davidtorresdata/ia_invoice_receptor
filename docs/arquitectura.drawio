  <diagram id="pagina-flujo" name="2 · Flujo de una factura">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="p2_0" />
        <mxCell id="p2_1" parent="p2_0" />

        <mxCell id="p2_title" value="Flujo de una factura — de la subida al dashboard" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="16" width="1170" height="30" as="geometry" />
        </mxCell>

        <!-- ================= COLUMNA CENTRAL: PIPELINE ================= -->
        <mxCell id="p2_s1" value="&lt;b&gt;1 · Cliente sube la factura&lt;/b&gt;&lt;br&gt;curl o interfaz Streamlit (PDF · PNG · JPG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="70" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s2" value="&lt;b&gt;2 · POST /api/v1/invoices/upload&lt;/b&gt; (multipart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="138" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_s3" value="&lt;b&gt;3 · UploadInvoiceUseCase valida&lt;/b&gt;&lt;br&gt;tamaño ≤ MAX_FILE_SIZE_MB · extension + magic bytes coherentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="198" width="380" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p2_s4" value="&lt;b&gt;4 · Guarda el blob&lt;/b&gt;&lt;br&gt;data/uploads/YYYY/MM/&lt;uuid&gt;__fichero (escritura atomica)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="270" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s5" value="&lt;b&gt;5 · INSERT document + job PENDING&lt;/b&gt;&lt;br&gt;una sola transaccion (Unit of Work)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="338" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s6" value="&lt;b&gt;6 · Encola tarea &quot;process_invoice&quot; en Redis&lt;/b&gt;&lt;br&gt;solo DESPUES de confirmar en BD (nunca trabajos fantasma)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="406" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s7" value="&lt;b&gt;7 · Worker Celery toma la tarea&lt;/b&gt;&lt;br&gt;job → PROCESSING (attempts += 1) · guarda celery_task_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="474" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s8" value="&lt;b&gt;8 · Extrae el texto&lt;/b&gt;&lt;br&gt;capa de texto (PyMuPDF) · Tesseract solo si la pagina esta escaneada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="542" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s9" value="&lt;b&gt;9 · LLM extrae datos estructurados&lt;/b&gt;&lt;br&gt;ExtractedInvoiceData (Pydantic) · mock determinista u OpenAI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="610" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s10" value="&lt;b&gt;10 · Construye el agregado Invoice&lt;/b&gt;&lt;br&gt;lineas ANTES del constructor (exige ≥ 1 item · total &gt; 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="678" width="380" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p2_s11" value="&lt;b&gt;11 · Valida reglas de negocio&lt;/b&gt;&lt;br&gt;subtotal + IVA = total · fechas · rangos  →  VALID / INVALID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="p2_1">
          <mxGeometry x="430" y="746" width="380" height="48" as="geometry" />
